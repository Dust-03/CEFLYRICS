{
  "name": "ceflirics",
  "version": "0.1.0",
  "private": true,
  "description": "Software de proyección para iglesias",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test:app": "electron-vite build && playwright test --project=app",
    "test:sync": "playwright test --project=patron --project=sincronia",
    "postinstall": "node node_modules/electron/install.js",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json && eslint . && prettier --check .",
    "format": "prettier --write .",
    "dist": "npm run bibles && electron-vite build && electron-builder --win",
    "bibles": "tsx scripts/build-bibles.mts",
    "medir": "electron-vite build && node scripts/medir-rendimiento.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "better-sqlite3": "^13.0.3"
  },
  "author": "Proyecto CEFLIRICS"
}
